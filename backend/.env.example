# BHOO-MITRA AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit real credentials to source control.

# ── App Settings ──────────────────────────────────────────────────────────────
APP_NAME=BHOO-MITRA AI API
APP_ENV=development
API_VERSION=0.1.0
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── PostgreSQL + PostGIS ──────────────────────────────────────────────────────
# Full connection URL (used by SQLAlchemy and Alembic)
DATABASE_URL=postgresql://bhoomitra_user:bhoomitra_pass@localhost:5432/bhoomitra_db

# Individual components (used by Docker Compose)
POSTGRES_DB=bhoomitra_db
POSTGRES_USER=bhoomitra_user
POSTGRES_PASSWORD=bhoomitra_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Repository Selection ──────────────────────────────────────────────────────
# postgres  → Use PostgreSQL + PostGIS (requires docker-compose up -d)
# mock      → Use in-memory synthetic demo data (no database required)
REPOSITORY_MODE=postgres

# ── Frontend API URL ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api
VITE_API_URL=http://localhost:8000/api
